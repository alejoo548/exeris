---
---
<!-- HERO -->
<section class="hero" id="top" data-screen-label="01 Hero">
  <div class="hero-coords" aria-hidden="true">
    <span class="tl"><span class="tick"></span>01.TL</span>
    <span class="tr">01.TR<span class="tick"></span></span>
    <span class="bl"><span class="tick"></span>01.BL</span>
    <span class="br">01.BR<span class="tick"></span></span>
  </div>
  <div class="crosshair tl" aria-hidden="true"></div>
  <div class="crosshair tr" aria-hidden="true"></div>
  <div class="crosshair bl" aria-hidden="true"></div>
  <div class="crosshair br" aria-hidden="true"></div>

  <div class="hero-grid">
    <!-- Left column: lockup + statement -->
    <div class="hero-col-main">
      <div class="hero-tag reveal">
        <span class="dot"></span>
        <span>EXR · 001 · 2026</span>
      </div>

      <img class="hero-logo reveal" src="/assets/exeris-logo.png" alt="EXERIS — Alta Precisión Quirúrgica" style="transition-delay: 100ms;" />

      <h1 class="hero-statement reveal" style="transition-delay: 200ms;">
        Una disciplina<br/>
        de <em>alta ingeniería</em> <br/>
        aplicada al cuerpo humano.
      </h1>

      <div class="hero-actions reveal" style="transition-delay: 320ms;">
        <a href="#manifesto" class="cta">Conocer el método</a>
        <a href="#contact" class="cta ghost">Agendar evaluación</a>
      </div>
    </div>

    <!-- Right column: aside detail (xAI/SpaceX-style sidebar) -->
    <aside class="hero-col-aside reveal" style="transition-delay: 380ms;">
      <div class="aside-row">
        <span class="aside-key">N°</span>
        <span class="aside-val">001 / Doctrina</span>
      </div>
      <div class="aside-row">
        <span class="aside-key">Lat.</span>
        <span class="aside-val">40°25′12″ N</span>
      </div>
      <div class="aside-row">
        <span class="aside-key">Long.</span>
        <span class="aside-val">03°41′28″ W</span>
      </div>
      <div class="aside-row">
        <span class="aside-key">Tol.</span>
        <span class="aside-val"><span class="accent">± 0.1 mm</span></span>
      </div>
      <div class="aside-row">
        <span class="aside-key">Sys.</span>
        <span class="aside-val">EXR.NX / 26</span>
      </div>
      <div class="aside-quote">
        <span class="quote-mark">“</span>
        No gestionamos la esperanza.<br/>
        Gestionamos la certeza.
      </div>
    </aside>
  </div>

  <!-- Cinematic image slot — full-bleed visual canvas -->
  <div class="hero-canvas reveal" style="transition-delay: 460ms;">
    <div class="img-slot dark" data-label="ASSET · SALA EXR-01 / PLANO PRINCIPAL · 16:7">
      <span class="slot-id">[ HERO-01 ]</span>
      <span class="slot-meta">DROP IMAGE</span>
      <div class="slot-center">
        <span class="ic">EXR</span>
        <span>IMAGEN PRINCIPAL · QUIRÓFANO / INSTRUMENTAL</span>
      </div>
    </div>
    <div class="canvas-label cl-tl">
      <span class="dot-mini"></span> CAPTURA · 24.03.2026 · 04:12 GMT
    </div>
    <div class="canvas-label cl-br">
      TOL · ± 0.1 MM <span class="sep"></span> EXR.NX/26
    </div>
  </div>

  <!-- Scroll down indicator -->
  <div class="scroll-ind" aria-hidden="true">
    <span>Desplazar</span>
    <div class="bar"></div>
  </div>
</section>
