---
---
<!-- LOGO MARK -->
<section class="mark" id="mark" data-screen-label="03 Mark">
  <div class="wrap">
    <div class="mark-grid">
      <div class="mark-intro reveal">
        <div>
          <div class="eyebrow">SECCIÓN — 03 / IDENTIDAD</div>
          <h2 style="margin-top:16px;">EL CORTE<br/>PERFECTO</h2>
        </div>
        <p>
          El símbolo de EXERIS es una abstracción de <em style="color:var(--text); font-style:normal; font-weight:500;">El Corte Perfecto</em>:
          la intersección exacta de dos planos de precisión milimétrica.
          Geometría, no ornamento. Cálculo, no metáfora.
        </p>
      </div>

      <!-- Wide isotype with construction lines -->
      <div class="glass mark-card wide reveal">
        <div class="glass-sheen"></div>
        <span class="corner-mark tl"></span>
        <span class="corner-mark tr"></span>
        <span class="corner-mark bl"></span>
        <span class="corner-mark br"></span>
        <div class="mark-label">
          <span>ISOTIPO · CONSTRUCCIÓN</span>
          <span class="id">[ M-01 ]</span>
        </div>
        <div class="mark-visual">
          <div class="construction" aria-hidden="true">
            <div class="v-line a"></div>
            <div class="h-line a"></div>
            <div class="corner tl"></div>
            <div class="corner tr"></div>
            <div class="corner bl"></div>
            <div class="corner br"></div>
            <div class="dim top">SIMETRÍA · 1:1</div>
            <div class="dim bottom">TOLERANCIA ± 0.1 MM</div>
            <div class="dim left">EJE · X</div>
          </div>
          <div class="iso-wrap" style="width:220px; height:220px;">
            <img src="/assets/exeris-logo.png" alt="" />
          </div>
        </div>
        <div class="mark-label">
          <span>X · INTERSECCIÓN DE DOS PLANOS</span>
          <span class="id">v 2.0</span>
        </div>
      </div>

      <!-- Horizontal lockup -->
      <div class="glass mark-card reveal">
        <div class="glass-sheen"></div>
        <span class="corner-mark tl"></span>
        <span class="corner-mark tr"></span>
        <span class="corner-mark bl"></span>
        <span class="corner-mark br"></span>
        <div class="mark-label">
          <span>HORIZONTAL · PRIMARIO</span>
          <span class="id">[ M-02 ]</span>
        </div>
        <div class="mark-visual">
          <img class="full-logo" src="/assets/exeris-logo.png" alt="EXERIS horizontal" />
        </div>
        <div class="mark-label">
          <span>LOCKUP · ESTÁNDAR</span>
          <span class="id">1:3.7</span>
        </div>
      </div>

      <!-- Vertical lockup -->
      <div class="glass mark-card reveal">
        <div class="glass-sheen"></div>
        <span class="corner-mark tl"></span>
        <span class="corner-mark tr"></span>
        <span class="corner-mark bl"></span>
        <span class="corner-mark br"></span>
        <div class="mark-label">
          <span>VERTICAL · SECUNDARIO</span>
          <span class="id">[ M-03 ]</span>
        </div>
        <div class="mark-visual">
          <div class="vert-wrap">
            <div class="iso-wrap">
              <img src="/assets/exeris-logo.png" alt="" />
            </div>
            <div class="word">
              <div class="name">EXERIS</div>
              <div class="tag">ALTA PRECISIÓN QUIRÚGRAFICA</div>
            </div>
          </div>
        </div>
        <div class="mark-label">
          <span>LOCKUP · COMPACTO</span>
          <span class="id">2:3</span>
        </div>
      </div>
    </div>
  </div>
</section>
